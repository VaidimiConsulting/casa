# ============================================================
# Casa Nest Homestay – Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=casa_nest

# Server
PORT=5000

# JWT
JWT_SECRET=your_very_long_and_secure_jwt_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway Credentials
# Replace with your actual Razorpay Key ID and Secret Key from https://dashboard.razorpay.com/app/keys


